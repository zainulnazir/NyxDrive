{
    "identifier": "xyz.nyxdrive.app",
    "build": {
      "beforeDevCommand": "npm run dev",
      "beforeBuildCommand": "npm run build",
      "devUrl": "http://localhost:1420",
      "frontendDist": "../dist"
    },
    "app": {
      "windows": [
        {
          "title": "NyxDrive",
          "width": 800,
          "height": 600
        }
      ],
      "security": {
        "csp": {
          "default-src": "'self'",
          "connect-src": "'self' https://*.telegram.org wss://*.telegram.org"
        }
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "plugins": {
      "shell": {
        "open": true
      },
      "fs": {
        "scope": ["$APPCONFIG/*"]
      },
      "http": {
        "all": true,
        "request": true,
        "scope": ["https://*.telegram.org/*"]
      },
      "dialog": {}
    }
  }